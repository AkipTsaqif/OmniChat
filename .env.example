# Neon Postgres connection string
OMNICHAT_DATABASE_URL='postgresql://user:password@host.neon.tech/dbname?sslmode=require'

# Auth.js session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=''

# AES-256-GCM key for encrypting provider API keys at rest (min 32 chars).
# Changing this makes every stored API key undecryptable.
OMNICHAT_ENCRYPTION_KEY=''

# --------------------------------------------------------------------------- #
# Web search (all optional).
#
# OmniChat always falls back to a keyless DuckDuckGo search, so a working setup
# needs none of these. Values here act as defaults and are overridden by the
# per-user settings in the app's Web Search dialog.
# --------------------------------------------------------------------------- #

# Tavily API key — https://tavily.com (free tier: 1,000 searches/month).
TAVILY_API_KEY=''

# Base URL of a self-hosted SearXNG instance — https://docs.searxng.org
# Its settings.yml must enable the `json` format and set `limiter: false`,
# otherwise the JSON endpoint answers 403.
OMNICHAT_SEARX_URL=''

# --------------------------------------------------------------------------- #
# Auth rate limits (all optional — defaults shown).
#
# Counters are in-memory: they reset on restart and do not coordinate across
# processes. This throttles credential guessing; it is not an authentication
# boundary.
# --------------------------------------------------------------------------- #

# Sign-in attempts per source address.        OMNICHAT_RATE_SIGNIN_IP_LIMIT='10'
# OMNICHAT_RATE_SIGNIN_IP_WINDOW_MS='60000'

# Sign-in attempts per submitted email.       OMNICHAT_RATE_SIGNIN_EMAIL_LIMIT='5'
# OMNICHAT_RATE_SIGNIN_EMAIL_WINDOW_MS='600000'

# Sign-ups per source address (abuse only — keep this looser than sign-in).
# OMNICHAT_RATE_SIGNUP_IP_LIMIT='20'
# OMNICHAT_RATE_SIGNUP_IP_WINDOW_MS='3600000'
